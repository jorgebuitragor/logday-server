# Copy to .env and fill in real values before running docker compose up.

# Required. Signs and verifies access tokens (JWT). Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Only used on the very first boot, when the instance has no users yet,
# to create the first admin account. Safe to leave set afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Exact origins allowed for cross-origin requests (e.g. a
# logday-web instance hosted separately from this server), comma
# separated. Empty (default) = CORS disabled, same as not setting
# this at all. No wildcard support — list each origin exactly.
#   CORS_ALLOWED_ORIGINS=https://logday.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=
