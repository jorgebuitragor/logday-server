# Copy to .env and fill in real values before running docker compose up.

# Required. Signs and verifies access tokens (JWT). Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Only used on the very first boot, when the instance has no users yet,
# to create the first admin account. Safe to leave set afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Exact origins allowed for cross-origin requests (e.g. a
# logday-web instance hosted separately from this server), comma
# separated. Empty (default) = CORS disabled, same as not setting
# this at all. No wildcard support — list each origin exactly.
#   CORS_ALLOWED_ORIGINS=https://logday.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Optional. Reverse proxies whose headers are believed about the real
# client IP (used by the login rate limit and shown per device in the
# panel), as IPs or CIDRs, comma separated. Empty (default) = use the
# connection's IP, which behind a proxy is the proxy's own: then every
# client shares one rate limit. Set it to your proxy's address or its
# Docker network, never to a range the internet can reach directly.
#   TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# Optional. Header with the client IP, read only from TRUSTED_PROXIES.
# Empty = X-Forwarded-For (walked from the right, skipping trusted
# proxies). Behind Cloudflare, with a proxy that doesn't trust it,
# use CF-Connecting-IP.
CLIENT_IP_HEADER=

# Optional. Body limit in MB for authenticated requests (notes, sync).
# Default 16. /auth/* is capped at 64 KiB and the panel at 1 MiB.
MAX_BODY_MB=
